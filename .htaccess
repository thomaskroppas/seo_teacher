# Корневые правила сайта (Apache на хостинге). Закрывает служебные файлы репозитория и добавляет защитные заголовки.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # служебные папки и файлы репозитория не должны отдаваться по URL
  RewriteRule (^|/)\.(git|claude|github|codex|cursor|gemini|kimi|zed)(/|$) - [F,L]
  RewriteRule ^(docs|tests|scripts|archive|relay)(/|$) - [F,L]
  RewriteRule ^(README|CLAUDE|AGENTS|CHANGELOG)[^/]*\.md$ - [F,L,NC]
</IfModule>

<FilesMatch "(^\.|\.(sqlite.*|log|sample\.php)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # CSP: только свои скрипты; стили допускают встроенные атрибуты style
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  # service worker и манифест должны обновляться сразу
  <FilesMatch "^(sw\.js|manifest\.webmanifest|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
